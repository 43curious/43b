    { name: "1.90", w: 2880, h: 1516, cat: "3K UHD", res: "3K UHD", ratio: "1.90" },
    { name: "2.00", w: 2880, h: 1440, cat: "3K UHD", res: "3K UHD", ratio: "2:1" },
    { name: "2.35", w: 2880, h: 1226, cat: "3K UHD", res: "3K UHD", ratio: "2.35" },
    { name: "2.37", w: 2880, h: 1216, cat: "3K UHD", res: "3K UHD", ratio: "2.37" },
    { name: "2.39", w: 2880, h: 1204, cat: "3K UHD", res: "3K UHD", ratio: "2.39" },
    { name: "2.40", w: 2880, h: 1200, cat: "3K UHD", res: "3K UHD", ratio: "2.40" },
    { name: "2.44", w: 2880, h: 1180, cat: "3K UHD", res: "3K UHD", ratio: "2.44" },
    // 1080p
    { name: "0.80 (4:5)", w: 864, h: 1080, cat: "1080p", res: "1080p", ratio: "4:5" },
    { name: "1.25 (5:4)", w: 1350, h: 1080, cat: "1080p", res: "1080p", ratio: "5:4" },
    { name: "1.33 (4:3)", w: 1440, h: 1080, cat: "1080p", res: "1080p", ratio: "4:3" },
    { name: "1.66 (5:3)", w: 1800, h: 1080, cat: "1080p", res: "1080p", ratio: "5:3" },
    { name: "1.78 (16:9)", w: 1920, h: 1080, cat: "1080p", res: "1080p", ratio: "16:9" },
    { name: "1.85", w: 1920, h: 1038, cat: "1080p", res: "1080p", ratio: "1.85" },
    { name: "1.90", w: 1920, h: 1010, cat: "1080p", res: "1080p", ratio: "1.90" },
    { name: "2.00", w: 1920, h: 960, cat: "1080p", res: "1080p", ratio: "2:1" },
    { name: "2.35", w: 1920, h: 816, cat: "1080p", res: "1080p", ratio: "2.35" },
    { name: "2.37", w: 1920, h: 810, cat: "1080p", res: "1080p", ratio: "2.37" },
    { name: "2.39", w: 1920, h: 802, cat: "1080p", res: "1080p", ratio: "2.39" },
    { name: "2.40", w: 1920, h: 800, cat: "1080p", res: "1080p", ratio: "2.40" },
    { name: "2.44", w: 1920, h: 786, cat: "1080p", res: "1080p", ratio: "2.44" },
    // 720p
    { name: "0.80 (4:5)", w: 576, h: 720, cat: "720p", res: "720p", ratio: "4:5" },
    { name: "1.25 (5:4)", w: 900, h: 720, cat: "720p", res: "720p", ratio: "5:4" },
    { name: "1.33 (4:3)", w: 960, h: 720, cat: "720p", res: "720p", ratio: "4:3" },
    { name: "1.66 (5:3)", w: 1200, h: 720, cat: "720p", res: "720p", ratio: "5:3" },
    { name: "1.78 (16:9)", w: 1280, h: 720, cat: "720p", res: "720p", ratio: "16:9" },
    { name: "1.85", w: 1280, h: 692, cat: "720p", res: "720p", ratio: "1.85" },
    { name: "1.90", w: 1280, h: 674, cat: "720p", res: "720p", ratio: "1.90" },
    { name: "2.00", w: 1280, h: 640, cat: "720p", res: "720p", ratio: "2:1" },
    { name: "2.35", w: 1280, h: 544, cat: "720p", res: "720p", ratio: "2.35" },
    { name: "2.37", w: 1280, h: 540, cat: "720p", res: "720p", ratio: "2.37" },
    { name: "2.39", w: 1280, h: 536, cat: "720p", res: "720p", ratio: "2.39" },
    { name: "2.40", w: 1280, h: 532, cat: "720p", res: "720p", ratio: "2.40" },
    { name: "2.44", w: 1280, h: 524, cat: "720p", res: "720p", ratio: "2.44" },
  ];

  const RES_OPTS = ["DCP 4K", "8K", "6K", "4K", "3K", "2K", "DCP 2K", "8K UHD", "5K", "4K UHD", "3K UHD", "1080p", "720p"];
  const RATIO_OPTS = ["1.85 (Flat)", "2.39 (Scope)", "1.90", "16:9", "2:1", "4:3", "4:5", "5:4", "5:3", "2.35", "2.37", "2.40", "2.44"];

  const RES_MAP: Record<string, number> = {
    "HD": 720, "720p": 720, "FHD": 1080, "1080p": 1080, "2K": 1152, "DCP 2K": 1080, "3K": 1728, "3K UHD": 1620,
    "4K": 2304, "4K UHD": 2160, "DCP 4K": 2160, "5K": 2880, "6K": 3456, "8K": 4608, "8K UHD": 4320
  };
  const RATIO_MAP: Record<string, number> = {
    "16:9": 1.777, "1.78": 1.777, "1.85": 1.85, "2.39": 2.39, "2.40": 2.40, "2:1": 2.0, "4:3": 1.333,
    "4:5": 0.8, "5:4": 1.25, "5:3": 1.666, "1.90": 1.9, "2.35": 2.35, "2.37": 2.37, "2.44": 2.44
  };

  let resVal = ""; 
  let ratioVal = "";
  let selected_item: ResolutionItem | null = null;
  const collapsedGroups = new Set(CAT_ORDER);

  const resInput = document.getElementById("resInput") as HTMLInputElement;
  const ratioInput = document.getElementById("ratioInput") as HTMLInputElement;
  const resList = document.getElementById("resList") as HTMLElement;
  const ratioList = document.getElementById("ratioList") as HTMLElement;
  const previewFrame = document.getElementById("previewFrame") as HTMLElement;
  const piName = document.getElementById("piName");
  const piDims = document.getElementById("piDims");
  const piRatio = document.getElementById("piRatio");
  const resultsList = document.getElementById("resultsList") as HTMLElement;

  function gcd(a: number, b: number): number { return b === 0 ? a : gcd(b, a % b); }
  function rat(w: number, h: number): string {
    const d = gcd(w, h), rw = w/d, rh = h/d;
    return (rw <= 32 && rh <= 32) ? `${rw}:${rh}` : (w/h).toFixed(3) + ":1";
  }

  function updateDynamic() {
    // 1. Exact Match Check (Precision Snap)
    const exact = DB.find(i => i.cat.toUpperCase() === resVal.toUpperCase() && (i.ratio === ratioVal || i.name.includes(ratioVal)));
    if (exact) {
      selected_item = exact;
      renderList();
      showPreview(exact.w, exact.h, exact.name);
      return;
    }

    // 2. Fallback to calculation
    const h = RES_MAP[resVal.toUpperCase()] || parseInt(resVal);
    let cleanRatio = ratioVal.split(" ")[0];
    const r = RATIO_MAP[cleanRatio] || parseFloat(cleanRatio);

    if (h > 0 && r > 0) {
      const w = Math.round(h * r);
      selected_item = null;
      renderList();
      showPreview(w, h, `${resVal.toUpperCase() || "Dynamic"} ${ratioVal || ""}`.trim());
    } else {
      renderList();
    }
  }

  function setupDropdown(input: HTMLInputElement, list: HTMLElement, options: string[]) {
    const show = () => {
      list.innerHTML = "";
      options.forEach(opt => {
        const div = document.createElement("div");
        div.className = "dropdown-item";
        div.textContent = opt;
        div.onmousedown = (e) => {
          e.preventDefault();
          input.value = opt;
          if (input.id === "resInput") resVal = opt;
          if (input.id === "ratioInput") ratioVal = opt;
          input.dispatchEvent(new Event("input"));
          list.classList.remove("on");
          updateDynamic();
        };
        list.appendChild(div);
      });
      list.classList.add("on");
    };

    input.onfocus = show;
    input.onclick = show;
    input.onblur = () => setTimeout(() => list.classList.remove("on"), 150);
    
    input.oninput = () => {
      const val = input.value.toLowerCase();
      if (!list.classList.contains("on")) list.classList.add("on");
      Array.from(list.children).forEach(child => {
        const match = child.textContent?.toLowerCase().includes(val);
        (child as HTMLElement).style.display = match ? "block" : "none";
      });
    };
  }

  function pick(item: ResolutionItem) {
    selected_item = item;
    resInput.value = item.cat;
    ratioInput.value = item.name;
    resVal = item.cat;
    ratioVal = item.name;
    renderList();
    showPreview(item.w, item.h, item.name);
    if (collapsedGroups.has(item.cat)) {
      collapsedGroups.delete(item.cat);
      renderList();
    }
  }

  const MAX_W = 560; const MAX_H = 280;

  function showPreview(w: number, h: number, name: string) {
    const ratio = w / h;
    let fw, fh;
    if (ratio > (MAX_W/MAX_H)) { fw = MAX_W; fh = Math.round(MAX_W/ratio); }
    else { fh = MAX_H; fw = Math.round(MAX_H*ratio); }
    if (previewFrame) { previewFrame.style.width = fw + "px"; previewFrame.style.height = fh + "px"; }
    if (piName) piName.textContent = name;
    if (piDims) piDims.textContent = `${w.toLocaleString()} × ${h.toLocaleString()}`;
    if (piRatio) piRatio.textContent = rat(w, h);
  }

  function renderList() {
    if (!resultsList) return;
    resultsList.innerHTML = "";
    const filtered = DB.filter(i => {
       const mR = !resVal || i.res.toLowerCase().includes(resVal.toLowerCase()) || i.cat.toLowerCase().includes(resVal.toLowerCase());
       const mT = !ratioVal || i.ratio.toLowerCase().includes(ratioVal.toLowerCase()) || i.name.toLowerCase().includes(ratioVal.toLowerCase());
       return mR && mT;
    });
    const groupsMap: Record<string, ResolutionItem[]> = {};
    filtered.forEach(i => { (groupsMap[i.cat] = groupsMap[i.cat] || []).push(i); });
    CAT_ORDER.forEach(cat => {
      if (!groupsMap[cat]) return;
      const isCollapsed = collapsedGroups.has(cat) && !resVal && !ratioVal;
      const gLabel = document.createElement("div"); gLabel.className = "group-label"; gLabel.innerHTML = `<span>${cat}</span> <span>▾</span>`;
      gLabel.onclick = () => { if (collapsedGroups.has(cat)) collapsedGroups.delete(cat); else collapsedGroups.add(cat); renderList(); };
      const gRows = document.createElement("div"); gRows.style.display = isCollapsed ? "none" : "block";
      groupsMap[cat].forEach(item => {
        const row = document.createElement("div"); row.className = "row" + (selected_item?.name === item.name && selected_item?.cat === item.cat ? " sel" : "");
        row.innerHTML = `<div class="r-name">${item.name}</div><div class="r-dims">${item.w}×${item.h}</div><div class="r-ratio">${rat(item.w,item.h)}</div>`;
        row.onclick = () => pick(item); gRows.appendChild(row);
      });
      resultsList.appendChild(gLabel); resultsList.appendChild(gRows);
    });
  }

  resInput.oninput = (e) => { resVal = (e.target as HTMLInputElement).value; updateDynamic(); };
  ratioInput.oninput = (e) => { ratioVal = (e.target as HTMLInputElement).value; updateDynamic(); };

  document.addEventListener('DOMContentLoaded', () => {
    setupDropdown(resInput, resList, RES_OPTS);
    setupDropdown(ratioInput, ratioList, RATIO_OPTS);
    pick(DB.find(i => i.cat === "1080p" && i.ratio === "16:9") || DB[0]);
  });
</script>
