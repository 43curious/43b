---
import Main from "../layouts/Main.astro";
---

<Main title="Herramientas" fullWidth={true} />

<div class="tools-wrapper">
  <div class="tools-container">
    <section class="tool-section">
      <div class="section-head">
        <p class="section-kicker mono">VIDEO</p>
        <h2 class="section-title">Resolucion y formato</h2>
      </div>

      <div class="preview-bar">
        <div class="preview-frame-wrap">
          <div id="previewFrame" class="preview-frame"></div>
        </div>

        <div class="preview-info">
          <div class="pi-block">
            <div class="pi-label">RESOLUCION</div>
            <div id="piName" class="pi-value"></div>
          </div>
          <div class="pi-block">
            <div class="pi-label">DIMENSIONES</div>
            <div id="piDims" class="pi-value"></div>
          </div>
          <div class="pi-block">
            <div class="pi-label">RELACION</div>
            <div id="piRatio" class="pi-value"></div>
          </div>
        </div>
      </div>

      <div class="selector-row">
        <div class="selector-group">
          <label for="resolutionSelect">RESOLUCION</label>
          <select id="resolutionSelect"></select>
        </div>

        <div class="selector-group">
          <label for="formatSelect">FORMATO</label>
          <select id="formatSelect"></select>
        </div>
      </div>

      <div class="custom-box">
        <div class="custom-head">
          <p class="custom-title">Cuadrado personalizado</p>
          <p class="custom-copy">Introduce ancho y alto y la relacion se calcula automaticamente.</p>
        </div>

        <div class="custom-grid">
          <div class="selector-group">
            <label for="customWidth">ANCHO</label>
            <input id="customWidth" type="number" min="1" placeholder="3840" />
          </div>
          <div class="selector-group">
            <label for="customHeight">ALTO</label>
            <input id="customHeight" type="number" min="1" placeholder="2160" />
          </div>
          <div class="selector-group">
            <label for="customRatio">RELACION</label>
            <input id="customRatio" type="text" readonly />
          </div>
        </div>
      </div>
    </section>

    <section class="tool-section">
      <div class="section-head">
        <p class="section-kicker mono">AUDIO</p>
        <h2 class="section-title">Calculadora de loudness</h2>
      </div>

      <div class="tool-grid">
        <div class="selector-group">
          <label for="loudnessTarget">DESTINO</label>
          <select id="loudnessTarget"></select>
        </div>
        <div class="selector-group">
          <label for="currentLufs">LOUDNESS ACTUAL (LUFS)</label>
          <input id="currentLufs" type="number" step="0.1" placeholder="-18" />
        </div>
        <div class="selector-group">
          <label for="truePeak">TRUE PEAK ACTUAL (dBTP)</label>
          <input id="truePeak" type="number" step="0.1" placeholder="-2" />
        </div>
      </div>

      <div class="result-panel">
        <div class="result-item">
          <div class="pi-label">OBJETIVO</div>
          <div id="targetValue" class="pi-value"></div>
        </div>
        <div class="result-item">
          <div class="pi-label">AJUSTE RECOMENDADO</div>
          <div id="gainAdjustment" class="pi-value"></div>
        </div>
        <div class="result-item">
          <div class="pi-label">TRUE PEAK MAXIMO</div>
          <div id="peakLimit" class="pi-value"></div>
        </div>
      </div>
    </section>

    <section class="tool-section">
      <div class="section-head">
        <p class="section-kicker mono">POST</p>
        <h2 class="section-title">Nombre de proyecto y estructura</h2>
      </div>

      <div class="tool-grid tool-grid-naming">
        <div class="selector-group">
          <label for="clientInput">CLIENTE</label>
          <input id="clientInput" type="text" placeholder="Acme" />
        </div>
        <div class="selector-group">
          <label for="projectInput">PROYECTO</label>
          <input id="projectInput" type="text" placeholder="Campana verano" />
        </div>
        <div class="selector-group">
          <label for="dateInput">FECHA</label>
          <input id="dateInput" type="date" />
        </div>
      </div>

      <div class="result-panel naming-panel">
        <div class="result-item result-item-wide">
          <div class="pi-label">NOMBRE SUGERIDO</div>
          <div id="projectSlug" class="pi-value"></div>
        </div>
      </div>

      <pre id="folderStructure" class="folder-structure"></pre>
    </section>
  </div>
</div>

<style>
  .tools-wrapper {
    min-height: 100vh;
    background: #fff;
    color: var(--text);
    font-size: 12px;
  }

  .tools-container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  .tool-section {
    padding: 24px 0 40px;
    border-bottom: 1px solid var(--line);
  }

  .tool-section:last-child {
    border-bottom: 0;
    padding-bottom: 80px;
  }

  .section-head {
    margin-bottom: 24px;
  }

  .section-kicker {
    margin: 0 0 6px;
    color: var(--dim);
    letter-spacing: 0.14em;
  }

  .section-title {
    margin: 0;
    font-size: 20px;
  }

  .section-title::after {
    display: none;
  }

  .preview-bar {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: center;
    margin-bottom: 24px;
  }

  .preview-frame-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 600px;
    height: 320px;
    background: #fafafa;
    border: 1px solid var(--line);
  }

  .preview-frame {
    position: relative;
    background: #fff;
    border: 1px solid var(--text);
    transition: width 0.2s ease, height 0.2s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .preview-frame::before,
  .preview-frame::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--line);
    transform: translate(-50%, -50%);
  }

  .preview-frame::before {
    width: 1px;
    height: 30%;
  }

  .preview-frame::after {
    width: 30%;
    height: 1px;
  }

  .preview-info,
  .result-panel {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
  }

  .pi-block,
  .result-item {
    min-width: 0;
    flex: 1;
  }

  .pi-label {
    margin-bottom: 4px;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
  }

  .pi-value {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.45;
  }

  .selector-row,
  .tool-grid,
  .custom-grid {
    display: flex;
    gap: 16px;
    align-items: end;
  }

  .tool-grid {
    margin-bottom: 20px;
  }

  .tool-grid-naming {
    margin-bottom: 20px;
  }

  .selector-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .selector-group label {
    color: var(--text);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .selector-group select,
  .selector-group input {
    width: 100%;
    padding: 9px 10px;
    border: 1px solid var(--line);
    border-radius: 0;
    background: #fff;
    color: var(--text);
    font-family: var(--mono);
    font-size: 12px;
    outline: none;
    appearance: none;
  }

  .selector-group select:focus,
  .selector-group input:focus {
    border-color: #bcbcbc;
  }

  .custom-box {
    margin-top: 20px;
    padding: 18px;
    border: 1px solid var(--line);
    background: #fafafa;
  }

  .custom-head {
    margin-bottom: 14px;
  }

  .custom-title {
    margin: 0 0 4px;
    font-weight: 600;
  }

  .custom-copy {
    margin: 0;
    color: var(--dim);
  }

  .naming-panel {
    margin-bottom: 16px;
  }

  .result-item-wide {
    flex: 1 1 100%;
  }

  .folder-structure {
    margin: 0;
    padding: 16px;
    border: 1px solid var(--line);
    background: #fafafa !important;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    overflow-x: auto;
  }

  @media (max-width: 640px) {
    .tools-container {
      padding: 0 16px 64px;
    }

    .preview-info,
    .selector-row,
    .tool-grid,
    .custom-grid,
    .result-panel {
      flex-direction: column;
      align-items: stretch;
    }

    .preview-frame-wrap {
      height: 240px;
    }
  }
</style>

<script>
  interface ResolutionOption {
    id: string;
    label: string;
    width: number;
    height: number;
  }

  interface FormatOption {
    id: string;
    label: string;
    ratio: number;
  }

  interface LoudnessTarget {
    id: string;
    label: string;
    lufs: number;
    peak: number;
  }

  const RESOLUTIONS: ResolutionOption[] = [
    { id: "720p", label: "HD 720p", width: 1280, height: 720 },
    { id: "1080p", label: "Full HD 1080p", width: 1920, height: 1080 },
    { id: "4k", label: "UHD 4K", width: 3840, height: 2160 },
    { id: "6k", label: "6K", width: 6144, height: 3456 },
    { id: "8k", label: "8K", width: 7680, height: 4320 },
  ];

  const FORMATS: FormatOption[] = [
    { id: "16x9", label: "16:9", ratio: 16 / 9 },
    { id: "239", label: "2.39", ratio: 2.39 },
    { id: "2x1", label: "2:1", ratio: 2 },
    { id: "4x3", label: "4:3", ratio: 4 / 3 },
    { id: "1x1", label: "1:1 Cuadrado", ratio: 1 },
    { id: "4x5", label: "4:5 Vertical", ratio: 4 / 5 },
    { id: "9x16", label: "9:16 Vertical", ratio: 9 / 16 },
  ];

  const LOUDNESS_TARGETS: LoudnessTarget[] = [
    { id: "youtube", label: "YouTube", lufs: -14, peak: -1 },
    { id: "spotify-video", label: "Plataformas / web", lufs: -16, peak: -1 },
    { id: "broadcast", label: "Broadcast EBU R128", lufs: -23, peak: -1 },
  ];

  const resolutionSelect = document.getElementById("resolutionSelect") as HTMLSelectElement;
  const formatSelect = document.getElementById("formatSelect") as HTMLSelectElement;
  const previewFrame = document.getElementById("previewFrame") as HTMLElement;
  const piName = document.getElementById("piName") as HTMLElement;
  const piDims = document.getElementById("piDims") as HTMLElement;
  const piRatio = document.getElementById("piRatio") as HTMLElement;
  const customWidth = document.getElementById("customWidth") as HTMLInputElement;
  const customHeight = document.getElementById("customHeight") as HTMLInputElement;
  const customRatio = document.getElementById("customRatio") as HTMLInputElement;
  const loudnessTarget = document.getElementById("loudnessTarget") as HTMLSelectElement;
  const currentLufs = document.getElementById("currentLufs") as HTMLInputElement;
  const truePeak = document.getElementById("truePeak") as HTMLInputElement;
  const targetValue = document.getElementById("targetValue") as HTMLElement;
  const gainAdjustment = document.getElementById("gainAdjustment") as HTMLElement;
  const peakLimit = document.getElementById("peakLimit") as HTMLElement;
  const clientInput = document.getElementById("clientInput") as HTMLInputElement;
  const projectInput = document.getElementById("projectInput") as HTMLInputElement;
  const dateInput = document.getElementById("dateInput") as HTMLInputElement;
  const projectSlug = document.getElementById("projectSlug") as HTMLElement;
  const folderStructure = document.getElementById("folderStructure") as HTMLElement;

  const MAX_W = 560;
  const MAX_H = 280;

  function gcd(a: number, b: number): number {
    return b === 0 ? a : gcd(b, a % b);
  }

  function ratioText(width: number, height: number) {
    const divisor = gcd(width, height);
    const rw = width / divisor;
    const rh = height / divisor;
    return rw <= 32 && rh <= 32 ? `${rw}:${rh}` : (width / height).toFixed(2);
  }

  function showPreview(width: number, height: number, label: string) {
    const ratio = width / height;
    let frameWidth;
    let frameHeight;

    if (ratio > MAX_W / MAX_H) {
      frameWidth = MAX_W;
      frameHeight = Math.round(MAX_W / ratio);
    } else {
      frameHeight = MAX_H;
      frameWidth = Math.round(MAX_H * ratio);
    }

    previewFrame.style.width = `${frameWidth}px`;
    previewFrame.style.height = `${frameHeight}px`;
    piName.textContent = label;
    piDims.textContent = `${width.toLocaleString()} × ${height.toLocaleString()}`;
    piRatio.textContent = ratioText(width, height);
  }

  function updatePresetPreview() {
    const resolution = RESOLUTIONS.find((item) => item.id === resolutionSelect.value) ?? RESOLUTIONS[0];
    const format = FORMATS.find((item) => item.id === formatSelect.value) ?? FORMATS[0];

    const width = resolution.width;
    const height = Math.round(width / format.ratio);
    showPreview(width, height, `${resolution.label} · ${format.label}`);
  }

  function updateCustomPreview() {
    const width = Number(customWidth.value);
    const height = Number(customHeight.value);

    if (!width || !height) {
      customRatio.value = "";
      return;
    }

    customRatio.value = ratioText(width, height);
    showPreview(width, height, "Personalizado");
  }

  function updateLoudness() {
    const target = LOUDNESS_TARGETS.find((item) => item.id === loudnessTarget.value) ?? LOUDNESS_TARGETS[0];
    const current = Number(currentLufs.value || 0);
    const peak = Number(truePeak.value || 0);
    const adjustment = target.lufs - current;
    const predictedPeak = peak + adjustment;

    targetValue.textContent = `${target.lufs.toFixed(0)} LUFS`;
    gainAdjustment.textContent = `${adjustment > 0 ? "+" : ""}${adjustment.toFixed(1)} dB`;
    peakLimit.textContent = `${target.peak.toFixed(0)} dBTP${predictedPeak > target.peak ? " · cuidado con clipping" : ""}`;
  }

  function slugify(value: string) {
    return value
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }

  function updateProjectStructure() {
    const client = clientInput.value.trim() || "cliente";
    const project = projectInput.value.trim() || "proyecto";
    const date = dateInput.value || new Date().toISOString().slice(0, 10);
    const projectName = `${date}_${slugify(client)}_${slugify(project)}`;

    projectSlug.textContent = projectName;
    folderStructure.textContent = `${projectName}
├── 00_admin
├── 01_brief
├── 02_media
│   ├── camera
│   ├── audio
│   ├── gfx
│   └── music
├── 03_project
│   ├── davinci
│   └── fcpx
├── 04_exports
│   ├── review
│   ├── master
│   └── socials
└── 05_archive`;
  }

  document.addEventListener("DOMContentLoaded", () => {
    RESOLUTIONS.forEach((resolution) => {
      const option = document.createElement("option");
      option.value = resolution.id;
      option.textContent = resolution.label;
      resolutionSelect.appendChild(option);
    });

    FORMATS.forEach((format) => {
      const option = document.createElement("option");
      option.value = format.id;
      option.textContent = format.label;
      formatSelect.appendChild(option);
    });

    LOUDNESS_TARGETS.forEach((target) => {
      const option = document.createElement("option");
      option.value = target.id;
      option.textContent = target.label;
      loudnessTarget.appendChild(option);
    });

    resolutionSelect.value = "4k";
    formatSelect.value = "16x9";
    loudnessTarget.value = "youtube";
    currentLufs.value = "-18";
    truePeak.value = "-2";
    dateInput.value = new Date().toISOString().slice(0, 10);

    resolutionSelect.addEventListener("change", updatePresetPreview);
    formatSelect.addEventListener("change", updatePresetPreview);
    customWidth.addEventListener("input", updateCustomPreview);
    customHeight.addEventListener("input", updateCustomPreview);
    loudnessTarget.addEventListener("change", updateLoudness);
    currentLufs.addEventListener("input", updateLoudness);
    truePeak.addEventListener("input", updateLoudness);
    clientInput.addEventListener("input", updateProjectStructure);
    projectInput.addEventListener("input", updateProjectStructure);
    dateInput.addEventListener("input", updateProjectStructure);

    updatePresetPreview();
    updateLoudness();
    updateProjectStructure();
  });
</script>
