---
import Main from "../layouts/Main.astro";
import AsciiSquare from "../components/AsciiSquare.astro";
import ContentTabs from "../components/ContentTabs.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Main title="Jon Castro">
  <div class="home-wrapper">
    <div class="hero">
      <div class="ascii-square-outer">
        <div class="hero-text-overlay">
          <h1 class="hero-name">JON CASTRO</h1>
          <p class="hero-bio dim">
            I build and use tools. This is a collection of technical guides and
            experiments—a reflection of my workflow and interests.
          </p>
        </div>
        <AsciiSquare interactive={true} class="max-w-[320px]" transitionName="ascii-hero" />
      </div>
    </div>

    <ContentTabs />
    <SiteFooter />
  </div>
</Main>

<style>
  .home-wrapper {
    max-width: 760px;
    margin: 80px auto 0;
    padding: 0 24px;
  }

  .hero {
    margin-bottom: 64px;
    width: 100%;
  }

  .ascii-square-outer {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    width: 100%;
  }

  .hero-text-overlay {
    max-width: 480px;
    text-align: right;
  }

  .hero-name {
    font-family: "Martian Mono", monospace;
    font-weight: 500;
    font-size: 16px;
    text-transform: uppercase;
    white-space: nowrap;
    margin-bottom: 12px;
    letter-spacing: -1px;
  }

  .hero-bio {
    font-size: 15px;
    line-height: 1.6;
    max-width: 48ch;
  }

  @media (max-width: 768px) {
    .ascii-square-outer {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 32px;
    }
  }
</style>
