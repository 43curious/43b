---
import Main from "../layouts/Main.astro";
import AsciiSquare from "../components/AsciiSquare.astro";
import ContentTabs from "../components/ContentTabs.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PrefetchLink from "../components/PrefetchLink.astro";
import { transactionSpecs } from "../data/transactions.data";
import { SITE_DESCRIPTION } from "../consts";
---

<Main title="Jon Castro" description={SITE_DESCRIPTION}>
  <div class="home-wrapper">
    <div class="hero">
      <div class="ascii-square-outer">
        <div class="hero-text-overlay">
          <h1 class="hero-name">JON CASTRO</h1>
          <p class="hero-bio dim">
            Diseno y utilizo herramientas. Este espacio reune guias tecnicas y
            experimentos que reflejan mi forma de trabajar y mis intereses.
          </p>
        </div>
        <AsciiSquare interactive={true} class="max-w-[320px]" transitionName="ascii-hero" />
      </div>
    </div>

    <div class="mb-12">
      <PrefetchLink 
        href="/expense-tracker" 
        spec={transactionSpecs.list}
        className="inline-flex items-center gap-2 bg-black text-white px-4 py-2 rounded-lg text-sm hover:bg-gray-800 transition-colors"
      >
        <span>View Snappy Expense Tracker</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </PrefetchLink>
    </div>

    <ContentTabs />
    <SiteFooter />
  </div>
</Main>

<style>
  .home-wrapper {
    max-width: 760px;
    margin: 80px auto 0;
    padding: 0 24px;
  }

  .hero {
    margin-bottom: 64px;
    width: 100%;
  }

  .ascii-square-outer {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    width: 100%;
  }

  .hero-text-overlay {
    max-width: 480px;
    text-align: right;
  }

  .hero-name {
    font-family: "Martian Mono", monospace;
    font-weight: 500;
    font-size: 16px;
    text-transform: uppercase;
    margin-bottom: 12px;
    letter-spacing: -1px;
  }

  .hero-bio {
    font-size: 15px;
    line-height: 1.6;
    max-width: 48ch;
  }

  @media (max-width: 768px) {
    .ascii-square-outer {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 32px;
    }
  }
</style>
