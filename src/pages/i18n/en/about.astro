---
import Main from "../../../layouts/Main.astro";
---

<Main title="About - Jon Castro" description="About Jon Castro" lang="en">
  <div class="page-shell page-copy">
    <header class="page-header">
      <h1>About</h1>
      <p class="page-intro">
        I write concise guides about technology, audiovisual workflow, and useful systems.
      </p>
    </header>

    <section class="section-list prose">
      <h2>Built with</h2>
      <ul>
        <li><a target="_blank" href="https://astro.build/">Astro</a> for the site.</li>
        <li><a target="_blank" href="https://www.markdownguide.org/">Markdown</a> and MDX for writing.</li>
        <li><a target="_blank" href="https://www.netlify.com/">Netlify</a> for deployment.</li>
      </ul>

      <h2>Daily tools</h2>
      <ul>
        <li><a target="_blank" href="https://obsidian.md/">Obsidian</a> for notes and drafts.</li>
        <li><a target="_blank" href="https://culturedcode.com/things/">Things</a> for tasks.</li>
        <li><a target="_blank" href="https://code.visualstudio.com/">Visual Studio Code</a> for code.</li>
        <li><a target="_blank" href="https://www.blackmagicdesign.com/es/products/davinciresolve/">DaVinci Resolve</a> for editing.</li>
      </ul>
    </section>
  </div>
</Main>
