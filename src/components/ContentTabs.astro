---
import type { CollectionEntry } from "astro:content";
import ArticleCard from "./ArticleCard.astro";
import ExperimentCard from "./ExperimentCard.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
  experiments: CollectionEntry<"experiments">[];
  postsLabel?: string;
  experimentsLabel?: string;
}

const {
  posts,
  experiments,
  postsLabel = "Guias",
  experimentsLabel = "Experimentos",
} = Astro.props;
---

<section class="content-tabs">
  <input id="tab-posts" class="tab-input" type="radio" name="content-tabs" checked />
  <input id="tab-experiments" class="tab-input" type="radio" name="content-tabs" />

  <nav class="tabs-nav" role="tablist" aria-label="Content sections">
    <label class="tab-label" for="tab-posts" role="tab" aria-controls="panel-posts">
      {postsLabel}
    </label>
    <label class="tab-label" for="tab-experiments" role="tab" aria-controls="panel-experiments">
      {experimentsLabel}
    </label>
  </nav>

  <div id="panel-posts" class="tab-panel">
    <div class="entry-list">
      {posts.map((post) => <ArticleCard blog={post} />)}
    </div>
  </div>

  <div id="panel-experiments" class="tab-panel">
    <div class="entry-list">
      {experiments.map((experiment) => <ExperimentCard experiments={experiment} />)}
    </div>
  </div>
</section>

<style>
  .content-tabs {
    display: grid;
    gap: 1rem;
  }

  .tab-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .tabs-nav {
    display: inline-flex;
    gap: 1.25rem;
    width: fit-content;
  }

  .tab-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid transparent;
    cursor: pointer;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    opacity: 0.45;
    text-transform: uppercase;
    transition: color 0.12s ease, border-color 0.12s ease, opacity 0.12s ease;
  }

  .tab-panel {
    display: none;
  }

  #tab-posts:checked ~ .tabs-nav label[for="tab-posts"],
  #tab-experiments:checked ~ .tabs-nav label[for="tab-experiments"] {
    color: var(--text);
    opacity: 1;
    border-bottom-color: var(--text);
  }

  #tab-posts:checked ~ #panel-posts,
  #tab-experiments:checked ~ #panel-experiments {
    display: block;
  }

  @media (max-width: 640px) {
    .tabs-nav {
      gap: 1rem;
    }

    .tab-label {
      justify-content: flex-start;
    }
  }
</style>
