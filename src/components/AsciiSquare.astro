---
interface Props {
  interactive?: boolean;
  title?: string;
  class?: string;
  transitionName?: string;
}

const {
  interactive = false,
  title = "",
  class: className = "",
  transitionName,
} = Astro.props;
---

<div
  class={`ascii-square-wrapper ${className}`}
  data-interactive={interactive.toString()}
  data-title={title}
  transition:name={transitionName}
>
  <div class="ascii-square" aria-label="Interactive ASCII Grid"></div>
</div>

<style>
  .ascii-square-wrapper {
    width: 100%;
  }

  .ascii-square {
    display: grid;
    gap: 1px;
    width: 100%;
    aspect-ratio: 1;
    padding: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: #e0e0e0;
    font-family: var(--font-mono);
    font-size: 8px;
    line-height: 1;
    user-select: none;
  }

  :global(.ascii-square .cell) {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.6s ease;
    cursor: default;
  }

  :global(.ascii-square .cell.trail) {
    transition: color 0s;
  }

  :global(.ascii-square .cell.shape) {
    font-weight: 900;
    transform: scale(1.3);
    transition:
      color 0.15s ease,
      filter 1.8s ease-in-out;
  }

  @keyframes idleBreath {
    0% {
      filter: brightness(1) saturate(1);
    }
    50% {
      filter: brightness(1.45) saturate(1.25);
    }
    100% {
      filter: brightness(1) saturate(1);
    }
  }

  :global(.ascii-square .cell.shape.idle) {
    animation: idleBreath 3s infinite alternate;
  }
</style>

<script>
  const SHAPES = {
    faq: { icon: "/icons/faq.png", color: "hsl(45, 100%, 45%)" },
    musica: { icon: "/icons/musica.svg", color: "hsl(280, 100%, 55%)" },
    utilidades: { icon: "/icons/utilidades.svg", color: "hsl(210, 100%, 50%)" },
    color: { icon: "/icons/DaVinci_Resolve_Studio.png", color: "hsl(220, 90%, 55%)" },
    organizar: { icon: "/icons/organizar.svg", color: "hsl(140, 100%, 40%)" },
    fcpx: { icon: "/icons/fcpx.png", color: "hsl(310, 100%, 60%)" },
    recursos: { icon: "/icons/recursos.svg", color: "hsl(180, 100%, 40%)" },
    computer: { icon: "/icons/computer.svg", color: "hsl(25, 100%, 55%)" },
    astro: { icon: "/icons/astro.svg", color: "hsl(330, 100%, 55%)" },
  };
  type ShapeKey = keyof typeof SHAPES;
  type GridCell = HTMLDivElement;
  type RenderState = { current: number; token: number };

  const TITLE_MAP = {
    faq: "faq",
    musica: "musica",
    "música": "musica",
    utilidades: "utilidades",
    color: "color",
    "gestion de color": "color",
    organizar: "organizar",
    organizart: "organizar",
    "final cut pro": "fcpx",
    recursos: "recursos",
    computer: "computer",
    ordenador: "computer",
    astro: "astro",
    blog: "astro",
  };

  const CHARS = ["░", "▒", "▓"];
  const TRAIL_COLORS = [
    "hsl(210,100%,60%)",
    "hsl(280,100%,65%)",
    "hsl(140,100%,50%)",
    "hsl(25,100%,60%)",
    "hsl(0,100%,65%)",
    "hsl(180,100%,50%)",
    "hsl(330,100%,60%)",
    "hsl(45,100%,50%)",
  ];
  const iconCache = new Map<string, Promise<Set<number>>>();

  function titleToShape(title: string): ShapeKey | null {
    const lower = title.toLowerCase();
    for (const [keyword, shape] of Object.entries(TITLE_MAP) as [string, ShapeKey][]) {
      if (lower.includes(keyword)) return shape;
    }
    return null;
  }

  function randomChar() {
    return CHARS[Math.floor(Math.random() * CHARS.length)];
  }

  function rasterizeIcon(src: string, gridSize: number): Promise<Set<number>> {
    const cacheKey = `${src}:${gridSize}`;
    if (iconCache.has(cacheKey)) return iconCache.get(cacheKey)!;

    const promise = new Promise<Set<number>>((resolve) => {
      const img = new Image();

      img.onload = () => {
        const sampleScale = 8;
        const sampleSize = gridSize * sampleScale;
        const padding = 2 * sampleScale;
        const targetSize = sampleSize - padding * 2;

        const canvas = document.createElement("canvas");
        canvas.width = sampleSize;
        canvas.height = sampleSize;

        const ctx = canvas.getContext("2d");
        if (!ctx) {
          resolve(new Set());
          return;
        }

        const scale = targetSize / Math.max(img.width, img.height);
        const scaledWidth = img.width * scale;
        const scaledHeight = img.height * scale;
        const offsetX = padding + (targetSize - scaledWidth) / 2;
        const offsetY = padding + (targetSize - scaledHeight) / 2;

        ctx.clearRect(0, 0, sampleSize, sampleSize);
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = "high";
        ctx.drawImage(img, offsetX, offsetY, scaledWidth, scaledHeight);

        const { data } = ctx.getImageData(0, 0, sampleSize, sampleSize);
        const activeCells = new Set<number>();

        for (let y = 0; y < gridSize; y++) {
          for (let x = 0; x < gridSize; x++) {
            let filledPixels = 0;

            for (let sy = 0; sy < sampleScale; sy++) {
              for (let sx = 0; sx < sampleScale; sx++) {
                const sampleX = x * sampleScale + sx;
                const sampleY = y * sampleScale + sy;
                const i = (sampleY * sampleSize + sampleX) * 4;
                const r = data[i];
                const g = data[i + 1];
                const b = data[i + 2];
                const a = data[i + 3];

                if (a >= 128 && !(r > 240 && g > 240 && b > 240)) {
                  filledPixels += 1;
                }
              }
            }

            if (filledPixels / (sampleScale * sampleScale) >= 0.34) {
              activeCells.add(y * gridSize + x);
            }
          }
        }

        resolve(activeCells);
      };

      img.onerror = () => resolve(new Set());
      img.src = src;
    });

    iconCache.set(cacheKey, promise);
    return promise;
  }

  function clearShape(cells: GridCell[]) {
    cells.forEach((cell) => {
      cell.classList.remove("shape", "idle", "trail");
      cell.textContent = randomChar();
      cell.style.color = "";
      cell.style.animationDelay = "";
    });
  }

  async function drawShape(
    cells: GridCell[],
    gridSize: number,
    shapeKey: ShapeKey | null,
    isStatic = false,
    tokenRef?: RenderState,
  ) {
    if (!shapeKey) return;

    const shape = SHAPES[shapeKey];
    if (!shape) return;

    const activeCells = await rasterizeIcon(shape.icon, gridSize);
    if (tokenRef && tokenRef.current !== tokenRef.token) return;

    const [, hue] = shape.color.match(/hsl\((\d+)/) ?? [];
    activeCells.forEach((idx: number) => {
      const cell = cells[idx];
      if (!cell) return;
      cell.classList.add("shape");
      if (isStatic) {
        cell.classList.add("idle");
        cell.style.animationDelay = `${Math.random() * 2}s`;
      }
      cell.textContent = "▓";
      const lightness = 35 + Math.random() * 20;
      cell.style.color = `hsl(${hue}, 90%, ${Math.round(lightness)}%)`;
    });
  }

  function initSquare(wrapper: HTMLElement) {
    if (wrapper.dataset.ready === "true") return;
    wrapper.dataset.ready = "true";

    const square = wrapper.querySelector(".ascii-square") as HTMLElement | null;
    if (!square) return;

    const interactive = wrapper.dataset.interactive === "true";
    const staticTitle = wrapper.dataset.title || "";
    const gridSize = 32;
    const cells: GridCell[] = [];
    const renderState = { current: 0, token: 0 };

    square.innerHTML = "";
    square.style.gridTemplateColumns = `repeat(${gridSize}, 1fr)`;

    for (let i = 0; i < gridSize * gridSize; i++) {
      const cell = document.createElement("div") as GridCell;
      cell.className = "cell";
      cell.textContent = randomChar();

      if (interactive) {
        cell.addEventListener("pointerover", () => {
          if (cell.classList.contains("shape")) return;
          cell.classList.add("trail");
          cell.style.color =
            TRAIL_COLORS[Math.floor(Math.random() * TRAIL_COLORS.length)];
          setTimeout(() => {
            cell.classList.remove("trail");
            if (!cell.classList.contains("shape")) cell.style.color = "";
          }, 600);
        });
      }

      square.appendChild(cell);
      cells.push(cell);
    }

    const activateShape = (title: string) => {
      renderState.current += 1;
      renderState.token = renderState.current;
      clearShape(cells);
      drawShape(cells, gridSize, titleToShape(title), false, renderState);
    };

    const resetShape = () => {
      renderState.current += 1;
      renderState.token = renderState.current;
      clearShape(cells);
    };

    if (interactive) {
      const rows = document.querySelectorAll(".article-row, .experiment-row");
      rows.forEach((row) => {
        row.addEventListener("mouseenter", () => {
          const title = row.querySelector(".title")?.textContent ?? "";
          activateShape(title);
        });
        row.addEventListener("mouseleave", resetShape);
      });

      Object.values(SHAPES).forEach((shape) => {
        rasterizeIcon(shape.icon, gridSize);
      });
    } else if (staticTitle) {
      drawShape(cells, gridSize, titleToShape(staticTitle), true, renderState);
    }
  }

  document
    .querySelectorAll(".ascii-square-wrapper")
    .forEach((wrapper) => initSquare(wrapper as HTMLElement));
</script>
