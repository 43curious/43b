---
/**
 * A dynamic transaction list component that uses the shared cache.
 */
---

<div id="transactions-container" class="space-y-4">
  <div class="animate-pulse flex space-x-4">
    <div class="flex-1 space-y-6 py-1">
      <div class="h-2 bg-slate-200 rounded"></div>
      <div class="space-y-3">
        <div class="grid grid-cols-3 gap-4">
          <div class="h-2 bg-slate-200 rounded col-span-2"></div>
          <div class="h-2 bg-slate-200 rounded col-span-1"></div>
        </div>
        <div class="h-2 bg-slate-200 rounded"></div>
      </div>
    </div>
  </div>
</div>

<script>
  import { queryClient } from '../lib/cache';
  import { transactionSpecs } from '../data/transactions.data';

  const container = document.getElementById('transactions-container');

  async function loadTransactions() {
    const spec = transactionSpecs.list;
    
    // Pattern: useData (manual implementation)
    
    // 1. Check if we already have it (Synchronous check for instant render)
    if (queryClient.has(spec.key)) {
      render(queryClient.getCached(spec.key));
    }

    // 2. Fetch/Refresh (this will hit the promise if prewarm is in flight)
    try {
      const data = await queryClient.fetchCached(spec.key, spec.fetcher);
      render(data);
    } catch (error) {
      console.error('Failed to load transactions', error);
      if (container) container.innerHTML = '<p class="text-red-500">Error loading data.</p>';
    }
  }

  function render(transactions: any[]) {
    if (!container) return;
    
    container.innerHTML = `
      <ul class="divide-y divide-gray-200">
        ${transactions.map(t => `
          <li class="py-4 flex justify-between items-center">
            <div>
              <p class="text-sm font-medium text-gray-900">${t.description}</p>
              <p class="text-sm text-gray-500">${t.category} • ${t.date}</p>
            </div>
            <span class="text-sm font-bold ${t.amount < 0 ? 'text-red-600' : 'text-green-600'}">
              ${t.amount.toLocaleString('en-US', { style: 'currency', currency: 'USD' })}
            </span>
          </li>
        `).join('')}
      </ul>
    `;
  }

  // Handle both initial load and view transitions
  loadTransactions();
  document.addEventListener('astro:after-swap', loadTransactions);
</script>
