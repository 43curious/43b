---
const {
  title,
  description,
  url = Astro.url,
  image,
  robots,
} = Astro.props;

const imageUrl =
  typeof image === "string" ? image : image?.src ? new URL(image.src, url).href : undefined;
---

<!-- SEO -->
<link rel="canonical" href={url} />

<!-- Open Graph -->
<meta property="og:site_name" content="Castro" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageUrl && <meta property="og:image:url" content={imageUrl} />}
{imageUrl && <meta property="og:image:secure_url" content={imageUrl} />}
<meta property="og:type" content="website" />
{imageUrl && <meta property="og:image:type" content="image/jpeg" />}
{imageUrl && <meta property="og:image:width" content="1200" />}
{imageUrl && <meta property="og:image:height" content="600" />}
<meta property="og:image:alt" content={title} />

<!-- Twitter -->
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:card" content="summary_large_image" />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
{imageUrl && <meta name="twitter:image:alt" content={title} />}
<meta name="twitter:domain" content={import.meta.env.SITE} />

<!-- HTML Meta Tags -->
<!-- Facebook Meta Tags -->
{robots && <meta name="robots" content="noindex, nofollow" />}
