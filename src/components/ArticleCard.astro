---
import type { CollectionEntry } from "astro:content";
import { titleToIconShape } from "../lib/ascii-config";
type Props = {
  blog: CollectionEntry<"blog">;
};
const { blog } = Astro.props;
const { title, pubDate, updatedDate } = blog.data;
const publishedAt = pubDate ?? updatedDate;
const formattedDate = publishedAt
  ? new Date(publishedAt).toISOString().split("T")[0]
  : "";
const shape = titleToIconShape(title);
---

<a href={`/blog/${blog.id}`} class="article-row" data-shape={shape}>
  <div class="row-content">
    <span class="title">{title}</span>
    {formattedDate && <span class="meta mono dim">{formattedDate}</span>}
  </div>
</a>

<style>
  .article-row {
    display: block;
    width: 100%;
    padding: 10px 12px;
    margin: 0 -12px;
    border-radius: 2px;
    transition: background 0.1s ease;
    text-decoration: none;
  }

  .article-row:hover {
    background: var(--hover);
  }

  .row-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  .meta {
    font-size: 12px;
    color: var(--dim);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .row-content {
      align-items: flex-start;
    }
    .meta {
      font-size: 10px;
    }
  }
</style>
