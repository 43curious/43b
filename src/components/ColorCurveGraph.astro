---
// src/components/ColorCurveGraph.astro
---

<div
    class="my-10 rounded-[20px] border border-[#e6e6e6] bg-[#fbfbfb] shadow-[0_1px_0_rgba(0,0,0,0.04)] overflow-hidden text-[#1b1b1b] color-curve-container"
    style="--rec709: #0066cc; --slog3: #c7254e;"
>
    <div
        class="px-6 py-5 border-b border-[#e6e6e6] bg-[#f7f7f7] flex flex-col gap-2"
    >
        <p
            class="text-[0.62rem] tracking-[0.38em] uppercase text-[#7a7a7a] m-0"
        >
            Rango Dinámico
        </p>
        <h3 class="text-lg sm:text-xl font-semibold text-[#111] m-0">
            Curvas de color: S-Log3 vs Rec.709
        </h3>
        <p class="text-[0.85rem] text-[#6a6a6a] m-0">
            Relación entre stops de exposición y valores IRE.
        </p>
    </div>

    <div class="px-6 pt-8 pb-10 md:px-8">
        <div
            class="relative w-full aspect-square max-w-[560px] mx-auto rounded-[18px] border border-[#e0e0e0] bg-white overflow-hidden"
        >
            <!-- Ejes -->
            <div
                class="absolute -left-12 top-1/2 -translate-y-1/2 -rotate-90 text-[10px] font-semibold text-[#7a7a7a] tracking-[0.28em] uppercase whitespace-nowrap"
            >
                IRE
            </div>
            <div
                class="absolute -bottom-8 left-1/2 -translate-x-1/2 text-[10px] font-semibold text-[#7a7a7a] tracking-[0.28em] uppercase whitespace-nowrap"
            >
                Stops de Rango Dinámico
            </div>

            <svg
                class="w-full h-full"
                viewBox="0 0 100 100"
                preserveAspectRatio="xMidYMid meet"
            >
                <defs>
                    <pattern
                        id="fine-grid"
                        width="6.25"
                        height="6.25"
                        patternUnits="userSpaceOnUse"
                    >
                        <path
                            d="M 6.25 0 L 0 0 0 6.25"
                            fill="none"
                            stroke="#f0f0f0"
                            stroke-width="0.45"></path>
                    </pattern>
                    <pattern
                        id="coarse-grid"
                        width="25"
                        height="25"
                        patternUnits="userSpaceOnUse"
                    >
                        <path
                            d="M 25 0 L 0 0 0 25"
                            fill="none"
                            stroke="#e6e6e6"
                            stroke-width="0.7"></path>
                    </pattern>
                    <clipPath id="chart-clip">
                        <rect x="2" y="2" width="96" height="96"></rect>
                    </clipPath>
                </defs>

                <!-- Fondo con rejilla -->
                <rect width="100" height="100" fill="url(#fine-grid)"></rect>
                <rect width="100" height="100" fill="url(#coarse-grid)"></rect>

                <!-- Ejes -->
                <g stroke="#cfcfcf" stroke-width="1">
                    <line x1="2" y1="2" x2="2" y2="98"></line>
                    <line x1="2" y1="98" x2="98" y2="98"></line>
                </g>

                <!-- Curvas -->
                <g clip-path="url(#chart-clip)">
                    <!-- Curva Rec.709 (lineal con clipping) -->
                    <path
                        data-curve="rec709"
                        d="M 2 98 L 18 78 L 30 60 L 40 46 L 50 34 L 60 24 L 72 14 L 84 7 L 98 2"
                        fill="none"
                        stroke="var(--rec709)"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="transition-opacity duration-300 opacity-100"
                    ></path>

                    <!-- Curva S-Log3 (log extendida) -->
                    <path
                        data-curve="slog3"
                        d="M 2 98 C 6 84, 14 70, 24 58 C 36 45, 52 34, 72 22 C 84 15, 92 9, 98 4"
                        fill="none"
                        stroke="var(--slog3)"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="transition-opacity duration-300 opacity-100"
                    ></path>
                </g>
            </svg>
        </div>

        <!-- Controles -->
        <div
            class="mt-6 flex items-center justify-center"
            role="tablist"
            aria-label="Filtros de curvas"
        >
            <div
                class="flex items-center gap-1 bg-white rounded-full border border-[#dcdcdc] p-1 shadow-[0_1px_0_rgba(0,0,0,0.05)]"
            >
                <button
                    type="button"
                    data-curve-filter="both"
                    class="px-3.5 py-1.5 text-[0.7rem] font-semibold rounded-full transition-colors bg-[#111] text-white"
                    aria-pressed="true"
                >
                    Ambas
                </button>
                <button
                    type="button"
                    data-curve-filter="slog3"
                    class="px-3.5 py-1.5 text-[0.7rem] font-semibold rounded-full transition-colors text-[#6a6a6a] hover:bg-[#f1f1f1]"
                    aria-pressed="false"
                >
                    S-Log3
                </button>
                <button
                    type="button"
                    data-curve-filter="rec709"
                    class="px-3.5 py-1.5 text-[0.7rem] font-semibold rounded-full transition-colors text-[#6a6a6a] hover:bg-[#f1f1f1]"
                    aria-pressed="false"
                >
                    Rec.709
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function setupColorCurves() {
        const containers = document.querySelectorAll(".color-curve-container");

        containers.forEach((container) => {
            const buttons = Array.from(
                container.querySelectorAll("[data-curve-filter]"),
            );
            const curves = {
                slog3: container.querySelector('[data-curve="slog3"]'),
                rec709: container.querySelector('[data-curve="rec709"]'),
            };

            function setButtonState(active: string) {
                buttons.forEach((btn) => {
                    const isActive =
                        btn.getAttribute("data-curve-filter") === active;
                    btn.setAttribute(
                        "aria-pressed",
                        isActive ? "true" : "false",
                    );
                    btn.classList.toggle("bg-[#111]", isActive);
                    btn.classList.toggle("text-white", isActive);
                    btn.classList.toggle("text-[#6a6a6a]", !isActive);
                    btn.classList.toggle("hover:bg-[#f1f1f1]", !isActive);
                });
            }

            function setCurveVisibility(mode: string) {
                const showBoth = mode === "both";
                if (curves.slog3) {
                    curves.slog3.classList.toggle(
                        "opacity-100",
                        showBoth || mode === "slog3",
                    );
                    curves.slog3.classList.toggle(
                        "opacity-0",
                        mode === "rec709",
                    );
                }
                if (curves.rec709) {
                    curves.rec709.classList.toggle(
                        "opacity-100",
                        showBoth || mode === "rec709",
                    );
                    curves.rec709.classList.toggle(
                        "opacity-0",
                        mode === "slog3",
                    );
                }
            }

            buttons.forEach((btn) => {
                btn.addEventListener("click", () => {
                    const mode =
                        btn.getAttribute("data-curve-filter") || "both";
                    setButtonState(mode);
                    setCurveVisibility(mode);
                });
            });
        });
    }

    // Ejecuta el setup cuando el documento cargue
    document.addEventListener("DOMContentLoaded", setupColorCurves);

    // Soporte para Astro View Transitions si están activadas
    document.addEventListener("astro:page-load", setupColorCurves);
</script>
