---
import { NAV_LINKS } from "../consts";

const currentPath = Astro.url.pathname;
const [homeLink, ...secondaryLinks] = NAV_LINKS;
---

<nav id="navbar">
  <div class="container-fluid nav-content">
    <a
      href={homeLink.href}
      class={currentPath === homeLink.href ? "active" : ""}
    >
      {homeLink.label}
    </a>

    <div class="nav-secondary">
      {
        secondaryLinks.map(({ href, label }) => (
          <a
            href={href}
            class={currentPath === href || currentPath.startsWith(`${href}/`) ? "active" : ""}
          >
            {label}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style>
  .nav-secondary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    .nav-secondary {
      gap: 1rem;
    }
  }
</style>
