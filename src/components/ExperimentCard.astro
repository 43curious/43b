---
import type { CollectionEntry } from "astro:content";
type Props = {
  experiments: CollectionEntry<"experiments">;
};
const { experiments } = Astro.props;
const { title, updatedDate } = experiments.data;
const formattedDate = updatedDate
  ? new Date(updatedDate).toISOString().split("T")[0]
  : "";
---

<a href={`/experiments/${experiments.id}`} class="experiment-row">
  <div class="row-content flex justify-between items-center w-full">
    <span class="title">{title}</span>
    <span class="meta mono dim">{formattedDate}</span>
  </div>
</a>

<style>
  .experiment-row {
    display: block;
    width: 100%;
    padding: 10px 12px;
    margin: 0 -12px;
    border-radius: 2px;
    transition: background 0.1s ease;
    text-decoration: none;
  }

  .experiment-row:hover {
    background: var(--hover);
  }

  .row-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  .meta {
    font-size: 12px;
    color: var(--dim);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .row-content {
      align-items: flex-start;
    }
  }
</style>
