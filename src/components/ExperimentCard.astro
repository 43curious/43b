---
import type { CollectionEntry } from "astro:content";
type Props = {
  experiments: CollectionEntry<"experiments">;
};
const { experiments } = Astro.props;
const { title } = experiments.data;
---

<a
  href={`/experiments/${experiments.id}`}
  class="text-black font-bold py-2.5 px-4 transition ease-in-out delay-50 hover:cursor-pointer text-xl gap-4
         flex flex-col sm:flex-row w-full sm:w-fit"
>
  <span class="opacity-80 hover:opacity-100">
    {title}
  </span>
</a>
