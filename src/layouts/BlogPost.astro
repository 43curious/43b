---
const { frontmatter } = Astro.props;
import Main from "./Main.astro";
import AsciiSquare from "../components/AsciiSquare.astro";

const date = frontmatter.pubDate || frontmatter.updatedDate;
const formattedDate = date ? new Date(date).toISOString().split("T")[0] : "";
---

<Main title={frontmatter.title} description={frontmatter.description} lang="es">
  <div class="page-shell post-wrapper">
    <header class="post-header">
      <div class="post-art">
        <div class="post-rectangle">
          <AsciiSquare title={frontmatter.title} transitionName="ascii-square" />
        </div>
      </div>

      <div class="post-meta">
        <h1 class="post-title">{frontmatter.title}</h1>
        {formattedDate && <p class="post-date mono">{formattedDate}</p>}
      </div>
    </header>

    <article class="prose-full">
      <slot />
    </article>
  </div>
</Main>

<style>
  .post-wrapper {
    padding-bottom: 4rem;
  }

  .post-header {
    margin-bottom: 3rem;
  }

  .post-art {
    margin-bottom: 5rem;
  }

  .post-rectangle {
    width: 100%;
    max-width: var(--ascii-square-size);
    margin: 0 auto;
  }

  .post-meta {
    display: grid;
    gap: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .post-title {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.05;
  }

  .post-content {
    font-size: 16px;
  }
</style>
