---
const { frontmatter } = Astro.props;
import Main from "./Main.astro";
import AsciiSquare from "../components/AsciiSquare.astro";
import SiteFooter from "../components/SiteFooter.astro";

const date = frontmatter.pubDate || frontmatter.updatedDate;
const formattedDate = date ? new Date(date).toISOString().split("T")[0] : "";
---

<Main title={frontmatter.title} description={frontmatter.description}>
  <div class="post-wrapper">
    <header class="post-header">
      <div class="post-art">
        <AsciiSquare
          title={frontmatter.title}
          class="max-w-[320px] mx-auto mb-20"
          transitionName="ascii-hero"
        />
      </div>

      <div class="post-meta">
        <span class="post-title">{frontmatter.title}</span>
        <span class="post-date">{formattedDate}</span>
      </div>
    </header>

    <article class="prose-full post-content">
      <slot />
    </article>

    <SiteFooter />
  </div>

</Main>

<script>
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      window.location.href = "/";
    }
  });
</script>

<style>
  .post-wrapper {
    max-width: 760px;
    margin: 0 auto;
    padding-bottom: 80px;
  }

  .post-header {
    margin: 64px 0 48px;
  }

  .post-art {
    margin-bottom: 16px;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 16px;
    margin-bottom: 80px;
    border-top: 1px solid var(--line);
  }

  .post-title,
  .post-date {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--dim);
  }

  .post-content {
    font-size: 16px;
  }

  @media (max-width: 640px) {
    .post-meta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
